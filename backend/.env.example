# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5100

# PostgreSQL connection (Aiven or local). SSL query params are ignored on
# purpose: TLS is configured explicitly in src/config/ssl.js.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Path to the CA certificate used to verify the database TLS certificate
# (relative to the backend folder, or absolute).
DB_SSL_CA_PATH=./src/config/aiven-ca.pem

# Long random string used to sign JWTs (for example: openssl rand -hex 48).
APP_SECRET=

JWT_EXPIRES_IN=1d

# Comma separated list of allowed browser origins.
FRONTEND_URL=http://localhost:3000

# Flat delivery fee applied to every order, in your currency's major unit.
DELIVERY_FEE=1500
