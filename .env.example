# Frontend environment template.
# Copy to `.env.local` for local development:  cp .env.example .env.local
#
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# NEVER put backend secrets here (DATABASE_URL, APP_SECRET, JWT secrets,
# Aiven credentials or any other server-side value).

# Backend API base URL (used by src/lib/api.js)
NEXT_PUBLIC_API_URL=http://localhost:5100/api

# Production example:
# NEXT_PUBLIC_API_URL=https://your-production-api.com/api
